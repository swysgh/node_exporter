[Unit]
Description=node_exporter - Prometheus 主机指标采集器
Documentation=file:/usr/share/doc/node_exporter/README.md
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3
Wants=network-online.target

[Service]
Type=simple

# 所有可调项都放在 /etc/node_exporter/config.json（字段见仓库 config.example.json），
# 命令行 flag 优先级更高，排查时可临时追加（如 -enable-smart -smart.device=/dev/sda）。
ExecStart=/usr/local/bin/node_exporter -config /etc/node_exporter/config.json

ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# S.M.A.R.T. 需要读取 /dev/sd*。
# 如需开启该模块，把下面的 User 改为 root，或配置 udev 规则后保持普通用户。
User=root
Group=root

# 安全加固
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no          # 采集 S.M.A.R.T. 需要访问真实块设备
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# 采集 smartctl/systemctl 都要能执行外部命令，
# 因此不能使用 RestrictAddressFamilies 之外的过度限制，这里只放开网络族。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
